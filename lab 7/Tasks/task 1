#include <iostream>   // Input-output library include kar rahe hain
using namespace std;  // Standard namespace use kar rahe hain

int main() {  // Main function start hota hai

    // Integer array declare aur initialize kar rahe hain
    int numbers[5] = {10, 20, 30, 40, 50};

    // Heading print kar rahe hain
    cout << "Array Elements:" << endl;

    // Loop array ke har element ko access karne ke liye
    for (int i = 0; i < 5; i++) {
        cout << numbers[i] << endl;  // Har element print kar rahe hain
    }

    return 0;  // Program successfully end
}
